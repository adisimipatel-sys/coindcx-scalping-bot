# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to GitHub.

# CoinDCX API (only needed if USE_REAL_ORDERS=true)
COINDCX_API_KEY=
COINDCX_API_SECRET=

# Telegram notifications (optional but recommended)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Strategy: trend_rider | trend_rr1 | rsi2_dip | rsi2_connors | rsi2_tight
#           | ema_pullback | bb_reversion   (compare: python strategy_lab.py)
STRATEGY=trend_rider

# false = paper trading / signals only (SAFE — start here)
# true  = real market orders on CoinDCX (crypto only)
USE_REAL_ORDERS=false

# Watchlists (comma separated)
CRYPTO_WATCHLIST=BTCINR,ETHINR,SOLINR,XRPINR,BNBINR,DOGEINR
FOREX_WATCHLIST=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD

# Risk settings
START_BALANCE=2000
RISK_PER_TRADE=0.01
MAX_OPEN_TRADES=3
MAX_TRADES_PER_DAY=15
DAILY_MAX_LOSS_PCT=0.03
COOLDOWN_MIN=30

# Timeframes
TIMEFRAME=5m
TREND_TIMEFRAME=1h
SCAN_DELAY=60
